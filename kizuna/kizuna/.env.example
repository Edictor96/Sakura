# Public Supabase browser configuration.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=https://sakura.example

# Server-only Prisma connection strings. Use pooled DATABASE_URL for runtime
# and a direct/session connection for migrations.
DATABASE_URL=
DIRECT_URL=

# Protect scheduled/provider ingestion routes. Keep this server-only.
INGESTION_ADMIN_TOKEN=

# Protect moderation administration routes. Keep this server-only.
MODERATION_ADMIN_TOKEN=

# Optional provider credentials. AniList currently needs no API key.
TMDB_API_KEY=
